# Copy to .env (which is git-ignored) and fill in.
# Use the READ-ONLY database user here, never the user the main server writes with.
# Host and database: copy them from MONGODB_URI in ../../server/.env. That URI has no
# database name, which means MongoDB's default database "test", so use "test" below.
READ_MONGODB_URI="mongodb+srv://readUser:<password>@<cluster-host>/test?retryWrites=true&w=majority"

# Port for this server (the main server uses 5000).
PORT=5001

ex with the current readUser:
READ_MONGODB_URI="mongodb+srv://readUser:aOzeXWk2sQ1yNKqq@crumbs1530.9q4u14v.mongodb.net/test?retryWrites=true&w=majority"
PORT=5001

