@@ -0,0 +1,128 @@
+require('dotenv').config();
+process.env.SESSION_SECRET = process.env.SESSION_SECRET || 'test-only-secret';
+
+const { describe, it, after } = require('node:test');
+const assert = require('node:assert');
+const mongoose = require('mongoose');
+const app = require('./app');
+const mockUsers = require('./auth/mockUsers');
+const { buildMockBookings, slotStart } = require('./bookings/mockBookings');
+const { toBookingViews } = require('./bookings/bookingViews');
+
+const rooms = [
+  { _id: 'r1', roomName: 'Study Room A', inBuilding: 'Hillman Library', roomNum: 101, capacity: 4 },
+  { _id: 'r2', roomName: 'Study Room B', inBuilding: 'Hillman Library', roomNum: 102, capacity: 6 },
+  { _id: 'r3', roomName: 'Group Room', inBuilding: 'Sennott Square', roomNum: 5500, capacity: 10 },
+  { _id: 'r4', roomName: 'Lost Room', inBuilding: 'Typo Hall', roomNum: 1, capacity: 2 },
+];
+const buildings = [
+  { buildName: 'Hillman Library', address: '3960 Forbes Ave', classification: 'Library' },
+  { buildName: 'Sennott Square', address: '210 S Bouquet St', classification: 'Academic' },
+];
+const buildingNames = new Set(buildings.map((b) => b.buildName));
+const account = mockUsers.accounts.find((a) => a.bookings.length >= 3);
+
+describe('mock bookings', () => {
+  const now = new Date(2026, 10, 19, 13, 47); // Thu 19 Nov 2026, 1:47 PM
+
+  it('turns { day, at } into a start time', () => {
+    assert.deepStrictEqual(slotStart({ day: 1, at: '10:00' }, now), new Date(2026, 10, 20, 10, 0));
+    assert.deepStrictEqual(slotStart({ day: -3, at: '16:30' }, now), new Date(2026, 10, 16, 16, 30));
+    assert.deepStrictEqual(slotStart({ day: 0, at: 'now' }, now), new Date(2026, 10, 19, 13, 30));
+  });
+
+  it('gives each slot a room from a known building, with an end after its start', () => {
+    const list = buildMockBookings(account, rooms, buildingNames, now);
+    assert.strictEqual(list.length, account.bookings.length);
+    for (const b of list) {
+      assert.ok(['r1', 'r2', 'r3'].includes(b.room), `picked ${b.room}, which has no known building`);
+      assert.ok(b.end > b.start);
+      assert.strictEqual(b.dataSource, 'mock');
+      assert.strictEqual(b.user, account.username);
+    }
+    // Different rooms while there are enough to go round.
+    const firstThree = list.slice(0, 3).map((b) => b.room);
+    assert.strictEqual(new Set(firstThree).size, 3);
+  });
+
+  it('is stable for the same account and rooms, whatever order the rooms come in', () => {
+    const a = buildMockBookings(account, rooms, buildingNames, now).map((b) => b.room);
+    const b = buildMockBookings(account, [...rooms].reverse(), buildingNames, now).map((x) => x.room);
+    assert.deepStrictEqual(a, b);
+  });
+
+  it('copes with no rooms and with accounts that have no bookings', () => {
+    const list = buildMockBookings(account, [], buildingNames, now);
+    assert.strictEqual(list.length, account.bookings.length);
+    assert.ok(list.every((b) => b.room === null));
+    assert.deepStrictEqual(buildMockBookings({ username: 'x', bookings: [] }, rooms, buildingNames, now), []);
+  });
+});
+
+describe('booking views', () => {
+  const bookings = [
+    { _id: 'b2', room: 'r3', start: new Date('2026-11-21T14:00:00Z'), end: new Date('2026-11-21T15:00:00Z') },
+    { _id: 'b1', room: 'r1', start: new Date('2026-11-20T10:00:00Z'), end: new Date('2026-11-20T12:00:00Z'), dataSource: 'mock' },
+    { _id: 'b3', room: 'gone', start: new Date('2026-11-22T09:00:00Z'), end: new Date('2026-11-22T10:00:00Z') },
+    { _id: 'b4', room: 'r4', start: new Date('2026-11-23T09:00:00Z'), end: new Date('2026-11-23T10:00:00Z') },
+  ];
+  const views = toBookingViews(bookings, rooms, buildings);
+
+  it('sorts soonest first', () => {
+    assert.deepStrictEqual(views.map((v) => v._id), ['b1', 'b2', 'b3', 'b4']);
+  });
+
+  it('attaches the room and its building', () => {
+    assert.deepStrictEqual(views[0].room, { _id: 'r1', roomName: 'Study Room A', roomNum: 101, capacity: 4 });
+    assert.deepStrictEqual(views[0].building, { name: 'Hillman Library', address: '3960 Forbes Ave', classification: 'Library' });
+    assert.strictEqual(views[0].status, 'active');
+    assert.strictEqual(views[0].dataSource, 'mock');
+  });
+
+  it('marks a missing room, and a room whose building is missing', () => {
+    assert.strictEqual(views[2].room, null);
+    assert.strictEqual(views[2].building, null);
+    assert.strictEqual(views[3].building.name, 'Typo Hall');
+    assert.strictEqual(views[3].building.address, null);
+  });
+});
+
+describe('GET /api/bookings (database)', () => {
+  let server;
+
+  it('returns the signed-in demo student\'s bookings with their rooms', async () => {
+    const uri = process.env.READ_MONGODB_URI;
+    assert.ok(uri, 'Database URI is missing from server/.env');
+    await mongoose.connect(uri);
+
+    await new Promise((resolve) => {
+      server = app.listen(0, resolve);
+    });
+    const baseUrl = `http://127.0.0.1:${server.address().port}`;
+
+    const login = await fetch(`${baseUrl}/api/auth/login`, {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ username: account.username, password: mockUsers.password }),
+    });
+    assert.strictEqual(login.status, 200);
+    const cookie = login.headers.get('set-cookie').split(';')[0];
+
+    const res = await fetch(`${baseUrl}/api/bookings`, { headers: { Cookie: cookie } });
+    assert.strictEqual(res.status, 200);
+    const list = await res.json();
+    assert.ok(Array.isArray(list), 'Expected GET /api/bookings to return a JSON array');
+
+    const mock = list.filter((b) => b.dataSource === 'mock');
+    assert.strictEqual(mock.length, account.bookings.length);
+    for (const b of mock) {
+      assert.ok(b.start && b.end, 'every booking has a time');
+      if (b.room) assert.ok(b.building && b.building.name, 'every booking with a room has a building name');
+    }
+  });
+
+  after(async () => {
+    if (server) server.close();
+    if (mongoose.connection.readyState !== 0) await mongoose.disconnect();
+  });
+});
diff --git a/viewer/server/src/bookings/bookingViews.js b/viewer/server/src/bookings/bookingViews.js
new file mode 100644
index 0000000..72ee1f7
--- /dev/null
+++ b/viewer/server/src/bookings/bookingViews.js
@@ -0,0 +1,38 @@
+// Turns stored (or mock) bookings into what the My Bookings page shows: the time,
+// plus where it is, looked up from the rooms and buildings collections.
+//
+// A booking points at its room by ObjectId (booking.room === room._id), and a room
+// points at its building by name (room.inBuilding === building.buildName), the
+// same name-based link the rest of the viewer uses.
+//
+// -> [{
+//      _id, start, end, status, dataSource,
+//      room:     { _id, roomName, roomNum, capacity } | null   (null: room no longer exists)
+//      building: { name, address, classification } | null      (address null: building not found)
+//    }]   soonest first
+function toBookingViews(bookings, rooms, buildings) {
+  const roomsById = new Map(rooms.map((r) => [String(r._id), r]));
+  const buildingsByName = new Map(buildings.map((b) => [b.buildName, b]));
+
+  return bookings
+    .map((booking) => {
+      const room = booking.room != null ? roomsById.get(String(booking.room)) : undefined;
+      const building = room ? buildingsByName.get(room.inBuilding) : undefined;
+      return {
+        _id: String(booking._id),
+        start: booking.start ?? null,
+        end: booking.end ?? null,
+        status: booking.status || 'active',
+        dataSource: booking.dataSource,
+        room: room
+          ? { _id: String(room._id), roomName: room.roomName, roomNum: room.roomNum, capacity: room.capacity }
+          : null,
+        building: room
+          ? { name: room.inBuilding, address: building?.address ?? null, classification: building?.classification ?? null }
+          : null,
+      };
+    })
+    .sort((a, b) => new Date(a.start) - new Date(b.start) || 0);
+}
+
+module.exports = { toBookingViews };
diff --git a/viewer/server/src/bookings/mockBookings.js b/viewer/server/src/bookings/mockBookings.js
new file mode 100644
index 0000000..f591871
--- /dev/null
+++ b/viewer/server/src/bookings/mockBookings.js
@@ -0,0 +1,83 @@
+// Demo bookings for the MOCK accounts in auth/mockUsers.js. They are built on
+// every request from the real `rooms` collection and come out in the same shape
+// as a stored booking, so the room/building lookup in bookingViews.js runs on them
+// exactly as it will on real bookings. Each one is marked dataSource: 'mock'.
+//
+// The same account always gets the same rooms (as long as the rooms don't
+// change), and the times are relative to today, so the demo never goes stale.
+
+const MINUTE = 60 * 1000;
+
+// Small deterministic hash + PRNG, so room picks are stable per username.
+function hashString(text) {
+  let h = 2166136261;
+  for (let i = 0; i < text.length; i += 1) {
+    h ^= text.charCodeAt(i);
+    h = Math.imul(h, 16777619);
+  }
+  return h >>> 0;
+}
+
+function seededRandom(seed) {
+  let a = seed;
+  return () => {
+    a = (a + 0x6d2b79f5) >>> 0;
+    let t = a;
+    t = Math.imul(t ^ (t >>> 15), t | 1);
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+function shuffled(items, seed) {
+  const random = seededRandom(seed);
+  const out = [...items];
+  for (let i = out.length - 1; i > 0; i -= 1) {
+    const j = Math.floor(random() * (i + 1));
+    [out[i], out[j]] = [out[j], out[i]];
+  }
+  return out;
+}
+
+// { day, at, minutes } -> start Date (server's local time)
+function slotStart({ day = 0, at }, now) {
+  const start = new Date(now);
+  start.setDate(start.getDate() + day);
+  if (at === 'now') {
+    start.setMinutes(start.getMinutes() < 30 ? 0 : 30, 0, 0);
+  } else {
+    const [hours, minutes] = String(at).split(':').map(Number);
+    start.setHours(hours, minutes || 0, 0, 0);
+  }
+  return start;
+}
+
+// account:        an entry from auth/mockUsers.js
+// rooms:          documents from the rooms collection
+// buildingNames:  Set of building names, so rooms that belong to a known building are preferred
+function buildMockBookings(account, rooms, buildingNames = new Set(), now = new Date()) {
+  const slots = account?.bookings ?? [];
+  if (slots.length === 0) return [];
+
+  const placed = rooms.filter((r) => buildingNames.has(r.inBuilding));
+  const candidates = (placed.length > 0 ? placed : rooms)
+    .slice()
+    .sort((a, b) => String(a._id).localeCompare(String(b._id)));
+  const pool = shuffled(candidates, hashString(account.username));
+
+  return slots.map((slot, i) => {
+    const room = pool.length > 0 ? pool[i % pool.length] : null;
+    const start = slotStart(slot, now);
+    return {
+      _id: `mock-${account.username}-${i + 1}`,
+      user: account.username,
+      room: room ? room._id : null,
+      start,
+      end: new Date(start.getTime() + slot.minutes * MINUTE),
+      status: 'active',
+      dataSource: 'mock',
+    };
+  });
+}
+
+module.exports = { buildMockBookings, slotStart };
diff --git a/viewer/server/src/models/Booking.js b/viewer/server/src/models/Booking.js
new file mode 100644
index 0000000..371a6ac
--- /dev/null
+++ b/viewer/server/src/models/Booking.js
@@ -0,0 +1,28 @@
+const mongoose = require('mongoose');
+
+// Read-side description of the `bookings` collection. The viewer never writes it:
+// creating, cancelling and editing bookings (US1-US3) belong to the main server,
+// which has the write user. This is the shape the My Bookings page reads, so
+// please store bookings like this:
+//
+//   user     Pitt username of the student who booked, e.g. "abc123"
+//            (the same id Pitt SSO will give us, and what the session holds)
+//   room     ObjectId of the booked document in `rooms`
+//   start    Date the booking starts
+//   end      Date the booking ends
+//   status   'active' (default) or 'cancelled'; cancelled bookings are not shown
+//
+// `strict: false` lets fields the main app adds later come through untouched.
+const bookingSchema = new mongoose.Schema(
+  {
+    user: String,
+    room: mongoose.Schema.Types.ObjectId,
+    start: Date,
+    end: Date,
+    status: String,
+    createdAt: Date,
+  },
+  { strict: false, collection: 'bookings' },
+);
+
+module.exports = mongoose.model('Booking', bookingSchema);
diff --git a/viewer/server/src/routes/auth.js b/viewer/server/src/routes/auth.js
new file mode 100644
index 0000000..504158c
--- /dev/null
+++ b/viewer/server/src/routes/auth.js
@@ -0,0 +1,40 @@
+const express = require('express');
+const provider = require('../auth/provider');
+const { setSessionCookie, clearSessionCookie, requireAuth } = require('../auth/session');
+
+const router = express.Router();
+
+// Mounted at /api/auth. Login and logout are the only non-GET requests the viewer
+// accepts (see the guard in app.js); they set or clear a cookie and never touch
+// the database.
+
+// GET /api/auth/provider -> what the sign-in page should show (mock: the demo accounts)
+router.get('/provider', (req, res) => res.json(provider.describe()));
+
+// POST /api/auth/login { username, password } -> { user } and a session cookie
+router.post('/login', express.json({ limit: '2kb' }), async (req, res) => {
+  const { username, password } = req.body ?? {};
+  if (typeof username !== 'string' || typeof password !== 'string' || !username.trim() || !password) {
+    return res.status(400).json({ error: 'Enter your Pitt username and password.' });
+  }
+  try {
+    const user = await provider.verifyCredentials(username, password);
+    if (!user) return res.status(401).json({ error: 'That username and password do not match.' });
+    setSessionCookie(res, user);
+    res.json({ user });
+  } catch (error) {
+    console.error(error);
+    res.status(500).json({ error: 'Sign-in failed' });
+  }
+});
+
+// POST /api/auth/logout -> 204, cookie cleared
+router.post('/logout', (req, res) => {
+  clearSessionCookie(res);
+  res.status(204).end();
+});
+
+// GET /api/auth/me -> { user } for the signed-in student, or 401
+router.get('/me', requireAuth, (req, res) => res.json({ user: req.user }));
+
+module.exports = router;
diff --git a/viewer/server/src/routes/bookings.js b/viewer/server/src/routes/bookings.js
new file mode 100644
index 0000000..0e4cca6
--- /dev/null
+++ b/viewer/server/src/routes/bookings.js
@@ -0,0 +1,40 @@
+const express = require('express');
+const Booking = require('../models/Booking');
+const Building = require('../models/Building');
+const Room = require('../models/Room');
+const { requireAuth } = require('../auth/session');
+const { findMockAccount } = require('../auth/provider');
+const { buildMockBookings } = require('../bookings/mockBookings');
+const { toBookingViews } = require('../bookings/bookingViews');
+
+const router = express.Router();
+
+// GET /api/bookings -> the signed-in student's bookings, soonest first, each with
+// its room and building (shape documented in bookings/bookingViews.js).
+//
+// Only ever returns the bookings of the student in the session cookie; there is
+// deliberately no ?user= parameter.
+//
+// Stored bookings come from the `bookings` collection. Mock accounts also get
+// demo bookings (dataSource: 'mock'), so the page has something to show before
+// the main app can create bookings.
+router.get('/bookings', requireAuth, async (req, res) => {
+  try {
+    const { username } = req.user;
+    const [stored, rooms, buildings] = await Promise.all([
+      Booking.find({ user: username, status: { $ne: 'cancelled' } }).lean(),
+      Room.find().lean(),
+      Building.find().lean(),
+    ]);
+
+    const account = findMockAccount(username);
+    const mock = account ? buildMockBookings(account, rooms, new Set(buildings.map((b) => b.buildName))) : [];
+
+    res.json(toBookingViews([...stored, ...mock], rooms, buildings));
+  } catch (error) {
+    console.error(error);
+    res.status(500).json({ error: 'Failed to fetch bookings' });
+  }
+});
+
+module.exports = router;
