diff --git a/viewer/client/src/features/bookings/MyBookings.jsx b/viewer/client/src/features/bookings/MyBookings.jsx
new file mode 100644
index 0000000..26c194e
--- /dev/null
+++ b/viewer/client/src/features/bookings/MyBookings.jsx
@@ -0,0 +1,114 @@
+import { useEffect, useMemo } from 'react';
+import { Link } from 'react-router-dom';
+import useApiGet from '../../hooks/useApiGet';
+import StatusMessage from '../../components/StatusMessage';
+import { useAuth } from '../auth/AuthContext';
+import BookingRow from './BookingRow';
+import { dayHeading, dayKey, hasEnded } from './format';
+import './MyBookings.css';
+
+// US5: a signed-in student sees the room (building, room number, address) and
+// the time of each of their bookings, grouped by day. Sign-in only: routes.jsx
+// wraps this page in <RequireAuth>.
+
+function groupByDay(bookings) {
+  const groups = new Map();
+  for (const b of bookings) {
+    const key = dayKey(b.start);
+    if (!groups.has(key)) groups.set(key, []);
+    groups.get(key).push(b);
+  }
+  return [...groups.values()];
+}
+
+function DayGroup({ bookings, now }) {
+  const { title, date } = dayHeading(bookings[0].start, now);
+  return (
+    <section className="bk-day">
+      <h3>
+        {title} <span className="bk-date">{date}</span>
+      </h3>
+      <ul className="bk-list">
+        {bookings.map((b) => (
+          <BookingRow key={b._id} booking={b} now={now} />
+        ))}
+      </ul>
+    </section>
+  );
+}
+
+export default function MyBookings() {
+  const { user, refresh } = useAuth();
+  const { data, loading, error, reload } = useApiGet('/bookings');
+  const sessionEnded = error?.response?.status === 401;
+
+  // The session ran out while the page was open: re-check, which sends the
+  // student back to the sign-in page.
+  useEffect(() => {
+    if (sessionEnded) refresh();
+  }, [sessionEnded, refresh]);
+
+  const { now, upcoming, past } = useMemo(() => {
+    const at = Date.now();
+    const all = data ?? [];
+    return {
+      now: at,
+      upcoming: all.filter((b) => !hasEnded(b, at)),
+      past: all.filter((b) => hasEnded(b, at)).reverse(), // most recent first
+    };
+  }, [data]);
+
+  const hasAny = upcoming.length + past.length > 0;
+
+  return (
+    <div className="bk">
+      <header className="bk-header">
+        <h1>My Bookings</h1>
+        {user && (
+          <p className="bk-sub">
+            Signed in as {user.name} ({user.username})
+          </p>
+        )}
+      </header>
+
+      <StatusMessage
+        loading={loading && !data}
+        error={error && !data && !sessionEnded}
+        onRetry={reload}
+      />
+
+      {data && !hasAny && (
+        <div className="bk-empty">
+          <p>You have no study room bookings.</p>
+          <Link to="/rooms">Browse study rooms</Link>
+        </div>
+      )}
+
+      {hasAny && (
+        <section aria-labelledby="bk-upcoming-title">
+          <h2 id="bk-upcoming-title">
+            Upcoming <span className="bk-count">{upcoming.length}</span>
+          </h2>
+          {upcoming.length === 0 ? (
+            <p className="bk-none">
+              Nothing coming up. <Link to="/rooms">Browse study rooms</Link>
+            </p>
+          ) : (
+            groupByDay(upcoming).map((group) => <DayGroup key={dayKey(group[0].start)} bookings={group} now={now} />)
+          )}
+        </section>
+      )}
+
+      {past.length > 0 && (
+        <details className="bk-past">
+          <summary>
+            Past bookings <span className="bk-count">{past.length}</span>
+          </summary>
+          {groupByDay(past).map((group) => (
+            <DayGroup key={dayKey(group[0].start)} bookings={group} now={now} />
+          ))}
+        </details>
+      )}
+    </div>
+  );
+}
diff --git a/viewer/client/src/features/bookings/format.js b/viewer/client/src/features/bookings/format.js
new file mode 100644
index 0000000..9e1ca7d
--- /dev/null
+++ b/viewer/client/src/features/bookings/format.js
@@ -0,0 +1,74 @@
+// Date and time wording for bookings, shown in the browser's time zone.
+
+const MINUTE = 60 * 1000;
+const DAY = 24 * 60 * MINUTE;
+
+function toDate(value) {
+  if (value == null) return null;
+  const d = new Date(value);
+  return Number.isNaN(d.getTime()) ? null : d;
+}
+
+function startOfDay(date) {
+  const d = new Date(date);
+  d.setHours(0, 0, 0, 0);
+  return d;
+}
+
+// Groups bookings by the local day they start on: 'YYYY-MM-DD', or 'none'.
+export function dayKey(value) {
+  const d = toDate(value);
+  if (!d) return 'none';
+  const pad = (n) => String(n).padStart(2, '0');
+  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
+}
+
+// -> { title: 'Today' | 'Tomorrow' | 'Yesterday' | 'Monday', date: 'November 19' }
+export function dayHeading(value, now = Date.now()) {
+  const d = toDate(value);
+  if (!d) return { title: 'No date set', date: '' };
+  const days = Math.round((startOfDay(d) - startOfDay(now)) / DAY);
+  const names = { 0: 'Today', 1: 'Tomorrow', [-1]: 'Yesterday' };
+  const sameYear = d.getFullYear() === new Date(now).getFullYear();
+  return {
+    title: names[days] ?? d.toLocaleDateString(undefined, { weekday: 'long' }),
+    date: d.toLocaleDateString(undefined, { month: 'long', day: 'numeric', ...(sameYear ? {} : { year: 'numeric' }) }),
+  };
+}
+
+// '1:30 – 3:00 PM'
+export function formatTimeRange(startValue, endValue) {
+  const start = toDate(startValue);
+  const end = toDate(endValue);
+  if (!start) return 'Time not set';
+  const time = new Intl.DateTimeFormat(undefined, { hour: 'numeric', minute: '2-digit' });
+  if (!end || end <= start) return time.format(start);
+  if (dayKey(start) !== dayKey(end)) {
+    const full = new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
+    return full.formatRange(start, end);
+  }
+  return time.formatRange(start, end);
+}
+
+// '2 hr', '1 hr 30 min', '45 min'
+export function formatDuration(startValue, endValue) {
+  const start = toDate(startValue);
+  const end = toDate(endValue);
+  if (!start || !end) return '';
+  const minutes = Math.round((end - start) / MINUTE);
+  if (minutes <= 0) return '';
+  const h = Math.floor(minutes / 60);
+  const m = minutes % 60;
+  return [h > 0 && `${h} hr`, m > 0 && `${m} min`].filter(Boolean).join(' ');
+}
+
+// A booking counts as past once it has ended; one with no end is past once it has started.
+export function hasEnded(booking, now = Date.now()) {
+  const end = toDate(booking.end) ?? toDate(booking.start);
+  return end ? end.getTime() <= now : false;
+}
+
+export function isInProgress(booking, now = Date.now()) {
+  const start = toDate(booking.start);
+  return Boolean(start) && start.getTime() <= now && !hasEnded(booking, now);
+}
